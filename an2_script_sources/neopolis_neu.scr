S_o3848 = 
{
	Start = function(State)
		State.CodeIndex = 0
		CallFunction(State.Thread, "Code0")
	end,

	Code0 = function(State)
		State.CodeIndex = 0
		Node_LeaveSimulation(State.Node)
		CallFunction(o3848, "Code1")
	end,

	Code1 = function(State)
		State.CodeIndex = 1
		if (State.CommandTable.CheckCondition(State) == 1) then
		else
			CallFunction(o3848, "Code2")
		end
	end,

	Code2 = function(State)
		State.CodeIndex = 2
		if (State.CommandTable.CheckCondition(State) == 1) then
			DipolLib.InUtero_Normal(State,"Code3")
		else
			CallFunction(o3848, "Code3")
		end
	end,

	Code3 = function(State)
		State.CodeIndex = 3
		Turret_SetAngleArea(State.Node, 180.000000, -20.000000, 70.000000)
		CallFunction(o3848, "Code4")
	end,

	Code4 = function(State)
		State.CodeIndex = 4
		if (State.CommandTable.CheckCondition(State) == 1) then
			TurretLib.Attack(State, 450.000000, 500.000000, "E", "", "", "","Code5")
		else
			CallFunction(o3848, "Code5")
		end
	end,

	Code5 = function(State)
		State.CodeIndex = 5
	end,

	CheckCondition = function(State)
		local execute_condition = 1

		if ((State.CodeIndex >= 1) and (State.CodeIndex < 2)) then 
			execute_condition = 0
		end

		return execute_condition
	end,

	ProcesseStateChange = function(State)
		if (State.CommandTable.CheckCondition(State) ~= 1) then
			 StopAllActiveBehaviours_AndCall(State, "Code"..(State.CodeIndex+1))
		end
	end,

}

