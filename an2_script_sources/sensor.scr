--------------------------------------------------------------------
-- This file implements the functions for the diverse atomic behaviours
--------------------------------------------------------------------



-- The behaviour forr the avp sensors.
SS_AvpStack = 
{
	
	Trigger_EnterPresence = function(State, Object)
		SetEngineValue(State, "Triggered", 1)
		Node_LeaveSimulation(State.Node)
	end,
	
	Trigger_EnterAcoustic = function(State, Object)
		SetEngineValue(State, "Triggered", 1)
		Node_LeaveSimulation(State.Node)
	end,
	
	Trigger_EnterVisible = function(State, Object)
		SetEngineValue(State, "Triggered", 1)
		Node_LeaveSimulation(State.Node)
	end, 	

}

SS_AvpStackLeave = 
{
	
	Trigger_LeavePresence = function(State, Object)
		SetEngineValue(State, "Triggered", 1)
		Node_LeaveSimulation(State.Node)
	end,
	
	Trigger_LeaveAcoustic = function(State, Object)
		SetEngineValue(State, "Triggered", 1)
		Node_LeaveSimulation(State.Node)
	end,
	
	Trigger_LeaveVisible = function(State, Object)
		SetEngineValue(State, "Triggered", 1)
		Node_LeaveSimulation(State.Node)
	end, 	

}


-- The behaciour for the shot hit stuff.
SS_ShotHit =
{
	Body_InformShotHit = function(State, Agressor, Bullet)
		SetEngineValue(State, "Attacked", 1)
		StopShotHit(State)
	end, 	
}

-- This is the state for the shield guard.
SS_ShieldGuard =
{
	Body_ObjectDestroyed = function(State)
		if (State.Thread.ShieldBehaviour.EscEjected == 0) then
			SetEngineValue(State, "Destroyed", 1)
			SetEngineValue(State, "DestJump", 1)
			SetEngineValue(State, "DestEmp", 1)
			SetEngineValue(State, "DestEmpJump", 1)
			SetEngineValue(State, "DestEsc", 1)
		end
		SetEngineValue(State, "KineticShield75", 1)
		SetEngineValue(State, "KineticShield50", 1)
		SetEngineValue(State, "KineticShield25", 1)
		SetEngineValue(State, "KineticShield10", 1)
	end,	
	
	Body_KinShieldBarrierReached = function(State, Barrier)
		if (State.Thread.ShieldBehaviour.KinLevel == 1) then
			State.Thread.ShieldBehaviour.KinLevel = 2
			SetEngineValue(State, "KineticShield75", 1)
			Body_RequestKinInfo(State.Node, 0.50)
		elseif (State.Thread.ShieldBehaviour.KinLevel == 2) then
			State.Thread.ShieldBehaviour.KinLevel = 3
			SetEngineValue(State, "KineticShield50", 1)
			Body_RequestKinInfo(State.Node, 0.25)
		elseif (State.Thread.ShieldBehaviour.KinLevel == 3) then
			State.Thread.ShieldBehaviour.KinLevel = 4
			SetEngineValue(State, "KineticShield25", 1)
			Body_RequestKinInfo(State.Node, 0.10)
		elseif (State.Thread.ShieldBehaviour.KinLevel == 4) then
			SetEngineValue(State, "KineticShield10", 1)
		end
	end,
	
	Body_EmpShieldBarrierReached = function(State, Barrier)
		if (State.Thread.ShieldBehaviour.EmpLevel == 1) then
			State.Thread.ShieldBehaviour.EmpLevel = 2
			SetEngineValue(State, "EmpShield75", 1)
			Body_RequestKinInfo(State.Node, 0.50)
		elseif (State.Thread.ShieldBehaviour.EmpLevel == 2) then
			State.Thread.ShieldBehaviour.EmpLevel = 3
			SetEngineValue(State, "EmpShield50", 1)
			Body_RequestKinInfo(State.Node, 0.25)
		elseif (State.Thread.ShieldBehaviour.EmpLevel == 3) then
			State.Thread.ShieldBehaviour.EmpLevel = 4
			SetEngineValue(State, "EmpShield25", 1)
			Body_RequestKinInfo(State.Node, 0.10)
		elseif (State.Thread.ShieldBehaviour.EmpLevel == 4) then
			SetEngineValue(State, "EmpShield10", 1)
		end
	end,
	
	Body_EscapePodEjected = function(State)
		State.Thread.ShieldBehaviour.EscEjected = 1
		SetEngineValue(State, "EscapePod", 1)
		SetEngineValue(State, "DestEsc", 1)
	end,
	
}


-- This is the command table for the enemy guard.
SS_EnemyGuard =
{
	Body_EnemyArrivalPatrol = function(State)
		CallFunction(State.Thread, State.Thread.EnemyGuard.Callback)
	end,	
}

SS_Threatening =
{
	
	Body_InformShotHit = function(State, Agressor, Shot)
		local shotList, lastEntry, firstEntry, time, table
			
		table = State.Thread.Threatening
		
		table.LT_LastAgressor = Agressor
		shotList = table.LT_ShotList
		lastEntry = table.LT_LastShot
		firstEntry = table.LT_FirstShot
		lastEntry = lastEntry + 1
		shotList[lastEntry] = Node_GetTime(State.Node)
		table.LT_LastShot = lastEntry
		-- We have to see if we have not reached the required number of shots already.
		if (lastEntry - firstEntry < table.LT_NumOfHits - 1) then
			-- Thats it.
			return
		end
		-- We have to check the time with the first one.
		if (shotList[lastEntry] - shotList[firstEntry] < table.LT_Time) then
			-- We go over to the finalize function
			table.LM_Finalize(State)
		end
		-- We froget the first value and increase by one.
		shotList[ firstEntry ] = nil
		table.LT_FirstShot = firstEntry + 1
	end,
	
	Body_KinShieldBarrierReached = function(State, Value)
		State.Thread.Threatening.LM_Finalize(State)
	end,
	
	LM_Finalize = function(State)
		local callback, param, table
		
		table = State.Thread.Threatening
		callback = table.LT_CallBack
		param = table.LT_LastAgressor
		-- Deactivate the shield guard.
		StopShieldGuard(State)
		StopShotHit(State)
		RemoveSensorBehaviour(State, State.Thread.Threatening)
		State.Thread.Threatening = nil
		-- Prepare the return value.
		CallFunction(State.Thread, callback, param)
	end,	
	
}

--------------------------------------------------------------------
-- Here comes the library
--------------------------------------------------------------------

-- This library defines the functionality of the miscelangelous stuff.
LibList.Sensor_Basis =
{
	-- PURPOSE
	-- This function activates the avp sensor.
	-- It does npot make use of the diverse distance setting functions.
	ActivateAvpSensor = function
	(
	State,			-- The state the sensor belongs to.
	FirstInterest,		-- The object we are most interested in.
	SecondInterest,		-- The object we are second most interested in.
	ThirdInterest,		-- The object we are third most interested in.
	FourthInterest,		-- The object we are fourth most intersted in.
	Hearing,		-- Flag, when we hear some thing
	Seeing,			-- Flag, when we see something
	Feeling,		-- Flag, when we feel something.
	CallBack		-- The callback we use, when a message has arrived.
	)
	
	
	local table
	
	-- Let us look after the different flags we use to acivate the sensor.	
	Trigger_ActivateSensor(State.Node, Feeling, Hearing, Seeing)
	Trigger_SetInterestList(State.Node, FirstInterest, SecondInterest, ThirdInterest, FourthInterest)
	table = CloneTable(SS_AvpStack)
	table.CallBack = CallBack
	InsertSensorBehaviour(State, "AVPSensor") 
	State.Thread.AvpBehaviour = table
	end,
	
	-- PURPOSE
	-- This function activates the avp sensor.
	-- It does npot make use of the diverse distance setting functions.
	ActivateAvpSensorComplex = function
	(
	State,			-- The state the sensor belongs to.
	AudioSensitivity,	-- The audio sensitivity "silent", "medium", "loud"
	FirstInterest,		-- The object we are most interested in.
	SecondInterest,		-- The object we are second most interested in.
	ThirdInterest,		-- The object we are third most interested in.
	FourthInterest,		-- The object we are fourth most intersted in.
	Hearing,		-- Flag, when we hear some thing
	Seeing,			-- Flag, when we see something
	Feeling			-- Flag, when we feel something.
	)
	
	
	local table
	
	-- Let us look after the different flags we use to acivate the sensor.	
	Trigger_ActivateSensor(State.Node, Feeling, Hearing, Seeing)
	Trigger_SetInterestList(State.Node, FirstInterest, SecondInterest, ThirdInterest, FourthInterest)
	Trigger_SetAcousticSensibility(State.Node, AudioSensitivity)
	table = CloneTable(SS_AvpStack)
	InsertSensorBehaviour(State, "AVPSensor", table) 
	State.Thread.AvpBehaviour = table
	end,
		
	-- PURPOSE
	-- This method deactivates the Avp-Behaviour.
	DeactivateAvpSensor = function(State)
		if (CheckSensorBehaviour(State, "AVPSensor")) then
			return
		end
		Trigger_StopSensor(State.Node)
		RemoveSensorBehaviour(State, "AVPSensor")
		State.Thread.AvpBehaviour = nil
	end,
	
	-- PURPOSE
	-- This function activates the avp sensor.
	-- It does npot make use of the diverse distance setting functions.
	ActivateAvpSensorComplexLeave = function
	(
	State,			-- The state the sensor belongs to.
	AudioSensitivity,	-- The audio sensitivity "silent", "medium", "loud"
	FirstInterest,		-- The object we are most interested in.
	SecondInterest,		-- The object we are second most interested in.
	ThirdInterest,		-- The object we are third most interested in.
	FourthInterest,		-- The object we are fourth most intersted in.
	Hearing,		-- Flag, when we hear some thing
	Seeing,			-- Flag, when we see something
	Feeling			-- Flag, when we feel something.
	)
	
	
	local table
	
	-- Let us look after the different flags we use to acivate the sensor.	
	Trigger_ActivateSensor(State.Node, Feeling, Hearing, Seeing)
	Trigger_SetInterestList(State.Node, FirstInterest, SecondInterest, ThirdInterest, FourthInterest)
	Trigger_SetAcousticSensibility(State.Node, AudioSensitivity)
	table = CloneTable(SS_AvpStackLeave)
	InsertSensorBehaviour(State, "AVPSensorLeave", table) 
	State.Thread.AvpBehaviourLeave = table
	end,
		
	-- PURPOSE
	-- This method deactivates the Avp-Behaviour.
	DeactivateAvpSensorLeave = function(State)
		if (CheckSensorBehaviour(State, "AVPSensorLeave")) then
			return
		end
		Trigger_StopSensor(State.Node)
		RemoveSensorBehaviour(State, "AVPSensorLeave")
		State.Thread.AvpBehaviourLeave = nil
	end,
	
	
	-- PURPOSE
	-- This method activates the shot hit sensor. We are informewd with a custom sensor, if we are shot upon.
	ActivateShotHitSensor = function
	(
	State		-- The state we are actually in.
	)
	local table
		
		-- We activate the shot hit sensor via the counting mechanism
		StartShotHit(State)
		table = CloneTable(SS_ShotHit)
		InsertSensorBehaviour(State, "ShotHit", table)
		State.Thread.ShotHitBehaviour = table
	end,
	
	
	-- PURPOSE
	-- This method deactivates the shot hit sensor.
	DeactivateShotHitSensor = function(State)
		if (CheckSensorBehaviour(State, "ShotHit")) then
			return
		end
		StopShotHit(State)
		RemoveSensorBehaviour(State, "ShotHit")
		State.Thread.ShotHitBehaviour = nil
	
	end,
	
	
	-- PURPOSE
	-- This method activates the shield guard. Depending on the parameters we are informed, if
	-- we are destroyed or if a critical value of a shield ha
	ActivateShieldGuard = function
	(
	State				-- The state we are in at them moment.	
	)
	local table
	
		StartShieldGuard(State)
		Body_RequestKinInfo(State.Node, 0.75)
		Body_RequestEmpInfo(State.Node, 0.75)
		-- We also start the escape pod behaviour.
		Body_StartEscapeBehaviour(State.Node)
		
		table = CloneTable(SS_ShieldGuard)
		table.EmpLevel = 1
		table.KinLevel = 1
		table.EscEjected = 0
		InsertSensorBehaviour(State, "ShieldGuard", table)
		State.Thread.ShieldBehaviour = table
	end,
	
	
	-- PURPOSE
	-- This method stops the already running shield guard.
	DeactivateShieldGuard = function(State)
		if (CheckSensorBehaviour(State, "ShieldGuard")) then
			return
		end
		StopShieldGuard(State)
		Body_StopEscapeBehaviour(State.Node)
		RemoveSensorBehaviour(State, "ShieldGuard")
		State.Thread.ShieldBehaviour = nil
	end,
	
	
	-- PURPOSE
	-- This method asks for the analysis of enemies in a certain area.
	ActivateEnemyGuard = function
	(
	State,			-- The actual state we are in.
	Callback,		-- The callback that should be triggered if we are about to be informed.
	WatchDistance,		-- The distance we would like to watch. 
	FirstPri, 		-- The prefix of the objects, we regard first priority.
	SecondPri, 		-- The prefix of the objects, we regard second priority.
	ThirdPri, 		-- The prefix of the objects, we regard third priority.
	FourthPri, 		-- The prefix of the objects, we regard fourth priority.
	PatrolArea		-- The patrol area, we do our patrol in.
	)
	local table
	
		StartEnemyPatrol(State, WatchDistance, FirstPri, SecondPri, ThirdPri, FourthPri, PatrolArea)
		table = CloneTable(SS_EnemyGuard)
		table.Callback = Callback
		InsertSensorBehaviour(State, "EnemyGuard", table)
		State.Thread.EnemyGuard = table 
	end,
	
	
	-- PURPOSE
	-- This method deactivates the analysis of the arrival of enemies.
	
	DeactivateEnemyGuard = function(State)
		if (CheckSensorBehaviour(State, "EnemyGuard")) then
			return
		end
		StopEnemyPatrol(State)
		RemoveSensorBehaviour(State, "EnemyGuard")
		State.Thread.EnemyGuard = nil
	end,
	
	-- PURPOSE
	-- This behaviour encapsulates Stefans special crietrion for beeing shot upon.
	ActivateThreatening = function
	(
	State, 
	CallBack,		-- The callback that should be triggered.
	NumOfHits,		-- The number of hits, when we feel threatened.
	TimeToReceive,		-- The time, when the hits must impact the vessel.
	KinShieldBarrier	-- The barrier of the kinetic shield when to start fighting.
	)
	local table
	
	
		table = CloneTable(SS_Threatening)
		
		table.LT_NumOfHits = NumOfHits
		table.LT_Time = TimeToReceive
		table.LT_CallBack = CallBack
		table.LT_ShotList = {}
		table.LT_FirstShot = 1
		table.LT_LastShot = 0
		InsertSensorBehaviour(State, "Threatening", table)
		State.Thread.Threatening = table
		StartShotHit(State)
		StartShieldGuard(State)
		Body_RequestKinInfo(State.Node, KinShieldBarrier)
	end,
	
	
	-- PURPOSE
	-- This method stops the threatening method.
	DeactivateThreatening = function(State)
		if (CheckSensorBehaviour(State, "Threatening")) then
			return
		end
		StopShieldGuard(State)
		StopShotHit(State)
		RemoveSensorBehaviour(State, "Threatening")
		State.Thread.Threatening = nil
	end,
	
	
	
}
		 	 